# Copy this file to .env and fill in real values.

ANTHROPIC_API_KEY=your_key_here

# Model artifact path (used by api/main.py to load the fine-tuned classifier)
MODEL_ARTIFACT_PATH=model/artifacts/suraksha-classifier

# SQLite path for flagged-message logging
DB_PATH=api/db/suraksha.db

# Set to true to bypass the ML model and use rules-only mode (useful before Step 5 is done)
RULES_ONLY_MODE=true
